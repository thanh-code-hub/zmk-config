#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    combos {
        compatible = "zmk,combos";

        sys_reset {
            bindings = <&sys_reset>;
            key-positions = <28 29 38 39 40 45>;
        };

        bootloader {
            bindings = <&bootloader>;
            key-positions = <28 29 39 38 44 41>;
        };

        studio_unlock {
            bindings = <&studio_unlock>;
            key-positions = <28 29 39 38 43 42>;
        };
    };

    behaviors {
        layer_1_rgb: layer_1_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo 1>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(125,89,54)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 1>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(0,0,0)>;
        };

        space_rgb: space_color {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp SPACE>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(113,100,50)>,
                <&macro_release>,
                <&kp SPACE>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;

            label = "SPACE_COLOR";
        };

        enter_rgb: enter_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp ENTER>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(240,100,58)>,
                <&macro_release>,
                <&kp ENTER>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;

            label = "ENTER_RGB";
        };

        esc_rgb: esc_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp ESCAPE>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(0,86,56)>,
                <&macro_release>,
                <&kp ESCAPE>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;

            label = "ESC_RGB";
        };

        del_rgb: del_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp DEL>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(287,85,40)>,
                <&macro_release>,
                <&kp DEL>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;

            label = "DEL_RGB";
        };

        backspace_rgb: backspace_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp BACKSPACE>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(44,91,33)>,
                <&macro_release>,
                <&kp BACKSPACE>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;

            label = "BACKSPACE_RGB";
        };

        DTLSHIFT: DTLSHIFT {
            compatible = "zmk,behavior-tap-dance";
            label = "DTLSHIFT";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&kp CAPSLOCK>;
        };

        DTDoubleQuote: DTDoubleQuote {
            compatible = "zmk,behavior-tap-dance";
            label = "DTDOUBLEQUOTE";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>, <&kp DOUBLE_QUOTES>;
        };

        DTUnderscore: DTUnderscore {
            compatible = "zmk,behavior-tap-dance";
            label = "DTUNDERSCORE";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDER>;
        };

        DTShiftAsterisk: DTShiftAsterisk {
            compatible = "zmk,behavior-tap-dance";
            label = "DTSHIFTASTERISK";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp ASTRK>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E             &kp R  &kp T       &kp C_PLAY_PAUSE  &kp C_MUTE      &kp Y       &kp U  &kp I          &kp O    &kp P     &DTUnderscore
&DTLSHIFT  &kp A  &kp S  &kp D             &kp F  &kp G       &esc_rgb          &backspace_rgb  &kp H       &kp J  &kp K          &kp L    &kp SEMI  &DTDoubleQuote
&kp LCTRL  &kp Z  &kp X  &kp C             &kp V  &kp B                                         &kp N       &kp M  &kp COMMA      &kp DOT  &kp FSLH  &mo 3
                         &kp LEFT_COMMAND  &mo 1  &space_rgb                                    &enter_rgb  &mo 2  &kp RIGHT_ALT
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN>,
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>,
                <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        number_symbol_2 {
            display-name = "EXTRA 2";
            bindings = <
&trans            &kp EQUAL  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans     &kp LEFT_BRACKET
&DTShiftAsterisk  &kp PLUS   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PERIOD    &trans  &trans  &kp PIPE          &kp GRAVE          &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp GRAVE  &kp RIGHT_SHIFT
&kp SLASH         &kp MINUS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COMMA                     &kp BACKSLASH     &kp EXCL           &kp AT                &kp HASH               &kp TILDE  &trans
                                           &trans        &trans        &trans                        &trans            &trans             &trans
            >;
        };

        nav_layer {
            display-name = "arrow_and_nav_and_del";
            bindings = <
&trans  &trans  &trans     &trans        &trans            &trans  &trans  &trans    &none   &kp HOME      &kp UP_ARROW    &kp END            &none       &none
&trans  &none   &kp LCTRL  &kp LEFT_ALT  &kp LEFT_COMMAND  &none   &trans  &del_rgb  &none   &kp LEFT      &kp DOWN_ARROW  &kp RIGHT          &kp RSHIFT  &none
&trans  &trans  &trans     &trans        &trans            &trans                    &none   &kp LC(LEFT)  &none           &kp LC(RC(RIGHT))  &none       &none
                           &trans        &trans            &trans                    &trans  &trans        &trans
            >;
        };

        function_layer {
            display-name = "Fn keys and function";
            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &rgb_ug RGB_COLOR_HSB(140,100,50)  &rgb_ug RGB_COLOR_HSB(0,85,48)
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans  &trans  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                       &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                  &bt BT_CLR       &trans           &trans           &trans           &trans                             &trans
                         &trans   &trans   &trans                  &trans           &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DEC C_BRI_UP>;
        };

        number_symbol_1 {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &trans  &trans  &kp NUMBER_6   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9      &kp N0             &trans
&trans  &kp EXCL      &kp AT        &kp HASH      &kp GRAVE     &kp TILDE     &trans  &trans  &kp BACKSLASH  &kp SLASH     &kp PIPE      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL
&trans  &none         &none         &none         &none         &none                         &none          &none         &trans        &trans            &trans             &trans
                                    &trans        &trans        &trans                        &trans         &trans        &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
